import module markup from './markup';
import class Markup from './markup';
import class LocalPath from './url';
import module url from './url';

// Safe HTML attribute descriptor. Unlike legacy Attrs, there is deliberately
// no public trusted_raw, dynamic-name factory, or raw-value promotion.
// Values are escaped once at the final HTML serialization boundary.
pub define class SafeAttr as
  private val string name;
  private val string value;
  private val bool enabled;

  private constructor(string name, string value, bool enabled) {
    self.name = name;
    self.value = value;
    self.enabled = enabled;
  }

  pub static fnc id(string value): SafeAttr {
    return new SafeAttr("id", value, true);
  }

  pub static fnc class_name(string value): SafeAttr {
    return new SafeAttr("class", value, true);
  }

  pub static fnc title(string value): SafeAttr {
    return new SafeAttr("title", value, true);
  }

  pub static fnc aria_label(string value): SafeAttr {
    return new SafeAttr("aria-label", value, true);
  }

  pub static fnc value(string value): SafeAttr {
    return new SafeAttr("value", value, true);
  }

  pub static fnc placeholder(string value): SafeAttr {
    return new SafeAttr("placeholder", value, true);
  }

  pub static fnc role(string value): SafeAttr {
    return new SafeAttr("role", value, true);
  }

  pub static fnc href_local(LocalPath path): SafeAttr {
    return new SafeAttr("href", url.render(path), true);
  }

  pub static fnc action_local(LocalPath path): SafeAttr {
    return new SafeAttr("action", url.render(path), true);
  }

  pub static fnc method_get(): SafeAttr {
    return new SafeAttr("method", "get", true);
  }

  pub static fnc method_post(): SafeAttr {
    return new SafeAttr("method", "post", true);
  }

  pub static fnc disabled(bool enabled): SafeAttr {
    return new SafeAttr("disabled", "", enabled);
  }

  pub render(): string {
    if self.enabled == false then
      return "";
    fi
    if self.name == "disabled" then
      return " disabled";
    fi
    return " " + self.name + "=\"" + markup.escape_html_data(self.value) + "\"";
  }
end

// Closed HTML node algebra: text, fragment, fixed ordinary elements and
// fixed void elements. No dynamic tags, raw HTML, <script> or <style> factory.
// Constructor copies input arrays so later caller mutations cannot change
// this node's membership; this is not proof of cross-actor heap isolation.
// The optional depth-limited preflight does not bound encoded output bytes,
// allocations, or the legacy eager render() entry point.
pub define class HtmlNode as
  private val string kind;
  private val string tag;
  private val string text_value;
  private val Array<SafeAttr> attributes;
  private val Array<HtmlNode> children;

  private constructor(string kind, string tag, string value, Array<SafeAttr> attributes, Array<HtmlNode> children) {
    self.kind = kind;
    self.tag = tag;
    self.text_value = value;
    // Take independent owned array snapshots before publishing this node.
    // Otherwise caller .add() operations can mutate a previously built tree
    // (and can even introduce a self-cycle through a captured input array).
    // Child nodes and attributes have private immutable fields themselves.
    let Array<SafeAttr> attrs_copy = arr[];
    for (val attr of attributes) {
      attrs_copy.add(attr as SafeAttr);
    }
    let Array<HtmlNode> children_copy = arr[];
    for (val child of children) {
      children_copy.add(child as HtmlNode);
    }
    self.attributes = attrs_copy;
    self.children = children_copy;
  }

  pub static fnc text(string value): HtmlNode {
    return new HtmlNode("text", "", value, [], []);
  }

  pub static fnc fragment(Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("fragment", "", "", [], children);
  }

  pub static fnc div(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "div", "", attributes, children);
  }

  pub static fnc span(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "span", "", attributes, children);
  }

  pub static fnc p(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "p", "", attributes, children);
  }

  pub static fnc h1(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "h1", "", attributes, children);
  }

  pub static fnc h2(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "h2", "", attributes, children);
  }

  pub static fnc main(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "main", "", attributes, children);
  }

  pub static fnc section(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "section", "", attributes, children);
  }

  pub static fnc nav(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "nav", "", attributes, children);
  }

  pub static fnc form(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "form", "", attributes, children);
  }

  pub static fnc button(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "button", "", attributes, children);
  }

  pub static fnc a(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "a", "", attributes, children);
  }

  pub static fnc ul(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "ul", "", attributes, children);
  }

  pub static fnc li(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "li", "", attributes, children);
  }

  pub static fnc title(Array<SafeAttr> attributes, Array<HtmlNode> children): HtmlNode {
    return new HtmlNode("element", "title", "", attributes, children);
  }

  pub static fnc input(Array<SafeAttr> attributes): HtmlNode {
    return new HtmlNode("void", "input", "", attributes, []);
  }

  pub static fnc br(Array<SafeAttr> attributes): HtmlNode {
    return new HtmlNode("void", "br", "", attributes, []);
  }

  pub static fnc hr(Array<SafeAttr> attributes): HtmlNode {
    return new HtmlNode("void", "hr", "", attributes, []);
  }

  pub static fnc meta(Array<SafeAttr> attributes): HtmlNode {
    return new HtmlNode("void", "meta", "", attributes, []);
  }

  pub static fnc link(Array<SafeAttr> attributes): HtmlNode {
    return new HtmlNode("void", "link", "", attributes, []);
  }

  // Depth guard for the safe tree only. It checks structure before eager
  // serialization; it is not an encoded-byte or allocation quota.
  // At depth=1, a single leaf/void element is admitted; every nested
  // child consumes one unit. A non-positive remaining budget fails closed.
  pub within_depth(int remaining): bool {
    if remaining < 1 then
      return false;
    fi
    for (val child of self.children) {
      val checked = child as HtmlNode;
      if checked.within_depth(remaining - 1) == false then
        return false;
      fi
    }
    return true;
  }

  pub render(): string {
    if self.kind == "text" then
      return markup.escape_html_data(self.text_value);
    fi

    let string rendered = "";
    if self.kind == "fragment" then
      for (val child of self.children) {
        val checked = child as HtmlNode;
        rendered = rendered + checked.render();
      }
      return rendered;
    fi

    rendered = "<" + self.tag;
    for (val attr of self.attributes) {
      val checked = attr as SafeAttr;
      rendered = rendered + checked.render();
    }
    rendered = rendered + ">";
    if self.kind == "void" then
      return rendered;
    fi

    for (val child of self.children) {
      val checked = child as HtmlNode;
      rendered = rendered + checked.render();
    }
    return rendered + "</" + self.tag + ">";
  }
end

define module safe_html as
  pub fnc render(HtmlNode node): string {
    val checked = node as HtmlNode;
    return checked.render();
  }

  // Validate depth before serializing any output. Do not change this to
  // truncation or to a recursive renderer that emits partial success.
  pub fnc render_with_depth_limit(HtmlNode node, int max_depth): Result<string, string> {
    val checked = node as HtmlNode;
    if max_depth < 1 then
      return Err("HTML maximum depth must be positive");
    fi
    if checked.within_depth(max_depth) == false then
      return Err("HTML nesting exceeds maximum depth");
    fi
    return Ok(checked.render());
  }

  // Reviewed bridge: only the closed SafeAttr/HtmlNode constructors can
  // produce the serialized bytes entering legacy Markup.trusted_raw here.
  // Never extend this bridge to accept caller-supplied HTML strings.
  pub fnc to_markup(HtmlNode node): Markup {
    return markup.trusted_raw(render(node));
  }
end
