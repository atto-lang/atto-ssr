import class Markup from './markup';
import module markup from './markup';

// Axum-like response boundary: rendering stays separate from the HTTP server.
// An Oreslang HTTP/router implementation can adapt this small value directly.
type HtmlResponse = {
  status: int,
  content_type: string,
  body: string
};

define module response as

  fnc build(int status, Markup body): HtmlResponse {
    val string rendered_body = markup.render(body);
    val result = struct{status: int, content_type: string, body: string}{
      status: status,
      content_type: "text/html; charset=utf-8",
      body: rendered_body
    };
    return result;
  }

  pub fnc with_status(int status, Markup body): Result<HtmlResponse, string> {
    // SSR response always carries body and HTML Content-Type.
    if status < 200 || status > 599 then
      return Err("renderable HTML status must be between 200 and 599");
    fi
    if status == 204 || status == 205 || status == 304 then
      return Err("HTTP status must not carry an HTML response body");
    fi

    return Ok(build(status, body));
  }

  pub fnc ok(Markup body): HtmlResponse {
    return build(200, body);
  }

  pub fnc fragment(Markup body): HtmlResponse {
    return build(200, body);
  }

  pub fnc created(Markup body): HtmlResponse {
    return build(201, body);
  }

  pub fnc not_found(Markup body): HtmlResponse {
    return build(404, body);
  }

end
