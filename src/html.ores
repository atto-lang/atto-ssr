import module markup from './markup';
import class Markup from './markup';
import class Stylesheet from './css';
import module css from './css';

// Serialized HTML attributes.
//
// Private immutable storage prevents structural fabrication of attributes.
pub define class Attrs as
  private val string html;

  private constructor(string value) {
    self.html = value;
  }

  pub static fnc trusted_raw(string value): Attrs {
    return new Attrs(value);
  }

  pub render(): string {
    return self.html;
  }
end

define module html as

  // Linked imports are not yet fully typed; validate the nominal wrapper at
  // the runtime boundary before any method dispatch on caller-supplied data.
  pub fnc attrs_render(Attrs value): string {
    val checked = value as Attrs;
    return checked.render();
  }

  // Only inert, fixed attribute names are accepted. URL, event, CSS, srcdoc,
  // HTMX and unknown contexts need separate policy and fail closed here.
  pub fnc attr(string name, string value): Result<Attrs, string> {
    if name == "id" || name == "class" || name == "title" || name == "alt"
      || name == "value" || name == "placeholder" || name == "role"
      || name == "aria-label" || name == "aria-description"
      || name == "aria-describedby" || name == "aria-labelledby" then
      return Ok(attr_trusted(name, markup.escape_html_data(value)));
    fi
    return Err("attribute requires a dedicated context policy or explicit trust");
  }

  pub fnc id(string value): Attrs {
    return attr_trusted("id", markup.escape_html_data(value));
  }

  pub fnc class_name(string value): Attrs {
    return attr_trusted("class", markup.escape_html_data(value));
  }

  pub fnc attrs_empty(): Attrs {
    return Attrs.trusted_raw("");
  }

  // Both name and value are raw and trusted. Use attr_value_trusted() for
  // a trusted attribute name with safely encoded HTML attribute value.
  pub fnc attr_trusted(string name, string value): Attrs {
    return Attrs.trusted_raw(" " + name + "=\"" + value + "\"");
  }

  // The name and URL/selector/expression semantics remain trusted, but
  // delimiter characters in the value cannot terminate the HTML attribute.
  pub fnc attr_value_trusted(string name, string value): Attrs {
    return attr_trusted(name, markup.escape_html_data(value));
  }

  pub fnc bool_attr_trusted(string name, bool enabled): Attrs {
    if enabled then
      return Attrs.trusted_raw(" " + name);
    fi

    return attrs_empty();
  }

  pub fnc id_trusted(string value): Attrs {
    return attr_value_trusted("id", value);
  }

  pub fnc class_trusted(string value): Attrs {
    return attr_value_trusted("class", value);
  }

  pub fnc href_trusted(string value): Attrs {
    return attr_value_trusted("href", value);
  }

  pub fnc action_trusted(string value): Attrs {
    return attr_value_trusted("action", value);
  }

  pub fnc method_trusted(string value): Attrs {
    return attr_value_trusted("method", value);
  }

  pub fnc attrs_join(Array<Attrs> attrs): Attrs {
    let string rendered = "";

    for (val attr of attrs) {
      rendered = rendered + attrs_render(attr);
    }

    return Attrs.trusted_raw(rendered);
  }

  // The tag name is trusted. This is intentionally not called element()
  // until Oreslang can validate/escape dynamic tag names safely.
  pub fnc element_trusted(string tag, Attrs attrs, Markup children): Markup {
    val string rendered_children = markup.render(children);
    return markup.trusted_raw(
      "<" + tag + attrs_render(attrs) + ">" +
      rendered_children +
      "</" + tag + ">"
    );
  }

  pub fnc void_element_trusted(string tag, Attrs attrs): Markup {
    return markup.trusted_raw("<" + tag + attrs_render(attrs) + ">");
  }

  pub fnc fragment(Array<Markup> children): Markup {
    return markup.join(children);
  }

  pub fnc document(Markup head, Markup body): Markup {
    val content = element_trusted(
      "html",
      attrs_empty(),
      markup.join([
        element_trusted("head", attrs_empty(), head),
        element_trusted("body", attrs_empty(), body)
      ])
    );

    val string rendered_content = markup.render(content);
    return markup.trusted_raw("<!doctype html>" + rendered_content);
  }

  pub fnc div(Attrs attrs, Markup children): Markup {
    return element_trusted("div", attrs, children);
  }

  pub fnc span(Attrs attrs, Markup children): Markup {
    return element_trusted("span", attrs, children);
  }

  pub fnc p(Attrs attrs, Markup children): Markup {
    return element_trusted("p", attrs, children);
  }

  pub fnc h1(Attrs attrs, Markup children): Markup {
    return element_trusted("h1", attrs, children);
  }

  pub fnc h2(Attrs attrs, Markup children): Markup {
    return element_trusted("h2", attrs, children);
  }

  pub fnc main(Attrs attrs, Markup children): Markup {
    return element_trusted("main", attrs, children);
  }

  pub fnc section(Attrs attrs, Markup children): Markup {
    return element_trusted("section", attrs, children);
  }

  pub fnc nav(Attrs attrs, Markup children): Markup {
    return element_trusted("nav", attrs, children);
  }

  pub fnc form(Attrs attrs, Markup children): Markup {
    return element_trusted("form", attrs, children);
  }

  pub fnc button(Attrs attrs, Markup children): Markup {
    return element_trusted("button", attrs, children);
  }

  pub fnc a(Attrs attrs, Markup children): Markup {
    return element_trusted("a", attrs, children);
  }

  pub fnc ul(Attrs attrs, Markup children): Markup {
    return element_trusted("ul", attrs, children);
  }

  pub fnc li(Attrs attrs, Markup children): Markup {
    return element_trusted("li", attrs, children);
  }

  pub fnc title(Attrs attrs, Markup children): Markup {
    return element_trusted("title", attrs, children);
  }

  // CSS has its own context; accept a Stylesheet rather than generic Markup.
  pub fnc style_sheet(Attrs attrs, Stylesheet sheet): Markup {
    return element_trusted(
      "style",
      attrs,
      markup.trusted_raw(css.render(sheet))
    );
  }

  // JavaScript has different escaping rules from HTML. Script source remains
  // an explicitly trusted string until a structural JS/script model exists.
  pub fnc script_trusted(Attrs attrs, string source): Markup {
    return element_trusted(
      "script",
      attrs,
      markup.trusted_raw(source)
    );
  }

  pub fnc input(Attrs attrs): Markup {
    return void_element_trusted("input", attrs);
  }

  pub fnc meta(Attrs attrs): Markup {
    return void_element_trusted("meta", attrs);
  }

  pub fnc link(Attrs attrs): Markup {
    return void_element_trusted("link", attrs);
  }

  pub fnc br(): Markup {
    return void_element_trusted("br", attrs_empty());
  }

  pub fnc hr(Attrs attrs): Markup {
    return void_element_trusted("hr", attrs);
  }

end
