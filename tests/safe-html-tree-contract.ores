import module markup from '../src/markup';
import module safe_html from '../src/safe_html';
import class SafeAttr from '../src/safe_html';
import class HtmlNode from '../src/safe_html';
import module url from '../src/url';

// A serialized HTML tree must keep data as text even with script-like input.
// Attributes are encoded at serialization; dynamic tag names are unavailable.
pub routine main(): void {
  val path = url.local_path(["users", "a_2"]).unwrap();
  val tree = HtmlNode.div(
    [
      SafeAttr.id("app"),
      SafeAttr.title("\" onclick=\"alert(1)"),
      SafeAttr.class_name("a&b")
    ],
    [
      HtmlNode.h1([], [HtmlNode.text("<Welcome>")]),
      HtmlNode.p([SafeAttr.aria_label("x'y")], [HtmlNode.text("</script>&<b>")]),
      HtmlNode.a([SafeAttr.href_local(path)], [HtmlNode.text("profile")]),
      HtmlNode.input([SafeAttr.disabled(true), SafeAttr.value("a\"b")]),
      HtmlNode.input([SafeAttr.disabled(false)])
    ]
  );

  stdio.println(safe_html.render(tree));
  stdio.println(safe_html.render(HtmlNode.fragment([
    HtmlNode.text("<"),
    HtmlNode.span([], [HtmlNode.text("A&B")]),
    HtmlNode.br([]),
    HtmlNode.text(">")
  ])));
  stdio.println(markup.render(safe_html.to_markup(tree)) == safe_html.render(tree));
  stdio.println(SafeAttr.method_get().render());
  stdio.println(SafeAttr.method_post().render());
  stdio.println(SafeAttr.disabled(false).render() == "");
  stdio.println(SafeAttr.href_local(path).render());
  stdio.println(SafeAttr.action_local(path).render());
  let Array<SafeAttr> attrs = arr[SafeAttr.id("stable")];
  let Array<HtmlNode> children = arr[HtmlNode.text("first")];
  val snapshot = HtmlNode.div(attrs, children);
  attrs.add(SafeAttr.title("late"));
  children.add(HtmlNode.text("late"));
  stdio.println(safe_html.render(snapshot));
  stdio.println(safe_html.render(HtmlNode.section([], [snapshot, snapshot])));
  // A late addition of the node to its original input array must not
  // introduce a recursive reference into the already-created snapshot.
  children.add(snapshot);
  stdio.println(safe_html.render(snapshot));

  val leaf = HtmlNode.text("<");
  val two_levels = HtmlNode.div([], [leaf]);
  val three_levels = HtmlNode.section([], [two_levels]);
  stdio.println(safe_html.render_with_depth_limit(leaf, 1).unwrap());
  stdio.println(safe_html.render_with_depth_limit(leaf, 0).is_err());
  stdio.println(safe_html.render_with_depth_limit(two_levels, 1).is_err());
  stdio.println(safe_html.render_with_depth_limit(two_levels, 2).unwrap());
  stdio.println(safe_html.render_with_depth_limit(three_levels, 2).is_err());
  stdio.println(safe_html.render_with_depth_limit(three_levels, 3).unwrap());
  stdio.println(safe_html.render_with_depth_limit(HtmlNode.br([]), 1).unwrap());
  stdio.println(safe_html.render_with_depth_limit(HtmlNode.fragment([leaf]), 1).is_err());
  stdio.println(safe_html.render_with_depth_limit(HtmlNode.fragment([leaf]), 2).unwrap());
  // Depth is capped at 64 and occurrence count at 4096 before render.
  // Duplicated references consume separate occurrences (not unique nodes).
  val pair = HtmlNode.div([], [HtmlNode.text("A"), HtmlNode.text("B")]);
  stdio.println(safe_html.render_with_limits(pair, 2, 3).unwrap());
  stdio.println(safe_html.render_with_limits(pair, 2, 2).is_err());
  stdio.println(safe_html.render_with_limits(pair, 1, 3).is_err());
  stdio.println(safe_html.render_with_limits(pair, 64, 4096).unwrap());
  stdio.println(safe_html.render_with_limits(pair, 65, 3).is_err());
  stdio.println(safe_html.render_with_limits(pair, 0, 3).is_err());
  stdio.println(safe_html.render_with_limits(pair, 2, 0).is_err());
  stdio.println(safe_html.render_with_limits(pair, 2, 4097).is_err());
  val repeated_leaf = HtmlNode.text("<x>");
  val repeated = HtmlNode.fragment([repeated_leaf, repeated_leaf]);
  stdio.println(safe_html.render_with_limits(repeated, 2, 3).unwrap());
  stdio.println(safe_html.render_with_limits(repeated, 2, 2).is_err());
  stdio.println(safe_html.render_with_depth_limit(leaf, 65).is_err());
  stdio.println(safe_html.render_with_depth_limit(leaf, 64).unwrap());
  // Boundary oracle using shared subtrees. Rendered occurrences count
  // includes repeated references, even though constructed objects are few.
  val level_0 = HtmlNode.text("x");
  val level_1 = HtmlNode.fragment([level_0, level_0]);
  val level_2 = HtmlNode.fragment([level_1, level_1]);
  val level_3 = HtmlNode.fragment([level_2, level_2]);
  val level_4 = HtmlNode.fragment([level_3, level_3]);
  val level_5 = HtmlNode.fragment([level_4, level_4]);
  val level_6 = HtmlNode.fragment([level_5, level_5]);
  val level_7 = HtmlNode.fragment([level_6, level_6]);
  val level_8 = HtmlNode.fragment([level_7, level_7]);
  val level_9 = HtmlNode.fragment([level_8, level_8]);
  val level_10 = HtmlNode.fragment([level_9, level_9]);
  val level_11 = HtmlNode.fragment([level_10, level_10]);
  val exactly_4096 = HtmlNode.fragment([level_11]);
  val over_4096 = HtmlNode.fragment([level_11, HtmlNode.text("y")]);
  stdio.println(safe_html.render_with_limits(exactly_4096, 64, 4096).is_err());
  stdio.println(safe_html.render_with_limits(exactly_4096, 64, 4095).is_err());
  stdio.println(safe_html.render_with_limits(over_4096, 64, 4096).is_err());
  stdio.println(safe_html.render_with_limits(over_4096, 64, 4095).is_err());
  // Attribute quota counts serialized occurrences even when children are
  // shared. A leaf owns two descriptors, and doubling 11 times gives 4096.
  val attr_level_0 = HtmlNode.input([SafeAttr.id("x"), SafeAttr.title("y")]);
  val attr_level_1 = HtmlNode.fragment([attr_level_0, attr_level_0]);
  val attr_level_2 = HtmlNode.fragment([attr_level_1, attr_level_1]);
  val attr_level_3 = HtmlNode.fragment([attr_level_2, attr_level_2]);
  val attr_level_4 = HtmlNode.fragment([attr_level_3, attr_level_3]);
  val attr_level_5 = HtmlNode.fragment([attr_level_4, attr_level_4]);
  val attr_level_6 = HtmlNode.fragment([attr_level_5, attr_level_5]);
  val attr_level_7 = HtmlNode.fragment([attr_level_6, attr_level_6]);
  val attr_level_8 = HtmlNode.fragment([attr_level_7, attr_level_7]);
  val attr_level_9 = HtmlNode.fragment([attr_level_8, attr_level_8]);
  val attr_level_10 = HtmlNode.fragment([attr_level_9, attr_level_9]);
  val attr_level_11 = HtmlNode.fragment([attr_level_10, attr_level_10]);
  val exact_attrs = HtmlNode.fragment([attr_level_11]);
  // 4095 nodes, 4097 attribute descriptors: one extra on the root.
  val extra_attrs = HtmlNode.div([SafeAttr.role("extra")], [attr_level_10, attr_level_10]);
  stdio.println(safe_html.render_with_resource_limits(exact_attrs, 64, 4096, 4096).is_err());
  stdio.println(safe_html.render_with_resource_limits(exact_attrs, 64, 4096, 4095).is_err());
  stdio.println(safe_html.render_with_resource_limits(extra_attrs, 64, 4096, 4096).is_err());
  stdio.println(safe_html.render_with_resource_limits(HtmlNode.text("x"), 1, 1, 0).unwrap() == "x");
  stdio.println(safe_html.render_with_resource_limits(HtmlNode.input([SafeAttr.disabled(false)]), 1, 1, 0).is_err());
  stdio.println(safe_html.render_with_resource_limits(HtmlNode.text("x"), 1, 1, -1).is_err());
  stdio.println(safe_html.render_with_resource_limits(HtmlNode.text("x"), 1, 1, 4097).is_err());
  return;
}
