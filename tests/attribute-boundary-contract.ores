import module markup from '../src/markup';
import module html from '../src/html';
import module htmx from '../src/htmx';

pub routine main(): void {
  stdio.println(markup.render(html.a(
    html.href_trusted("/search?q=\" onmouseover=\"alert(1)&x=<b>"),
    markup.text("Safe <link>")
  )));
  stdio.println(markup.render(html.form(
    html.action_trusted("/submit\" onsubmit=\"steal()&q='"),
    markup.text("form")
  )));
  stdio.println(markup.render(html.input(
    html.attrs_join([
      html.id_trusted("user\" autofocus=\"true"),
      html.class_trusted("x&y")
    ])
  )));
  stdio.println(markup.render(html.button(
    htmx.post_trusted("/save\" onclick=\"bad()&item=<1>"),
    markup.text("Save")
  )));
  stdio.println(markup.render(html.div(
    html.attrs_join([
      htmx.target_trusted("#slot\" onclick=\"bad()"),
      htmx.trigger_trusted("click\" onfocus=\"bad()"),
      htmx.vals_trusted("{\"x\":\"<tag>&'\"}")
    ]),
    markup.text("Data")
  )));
  stdio.println(markup.render(html.div(
    htmx.sse_connect_trusted("/events?name=\" onmouseover=\"bad()&a=<b>"),
    markup.text("SSE")
  )));
  return;
}
