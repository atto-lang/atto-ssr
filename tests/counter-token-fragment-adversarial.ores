import module markup from '../src/markup';
import module counter_view from '../src/counter_view';

// No token-bearing HTML is emitted to stdout; assert only true/false values.
pub routine main(): void {
  val fragment = markup.render(
    counter_view.fragment("<img src=x onerror=alert(1)>", "x\" onfocus=\"steal&")
  );
  stdio.println(fragment.replace_literal("hx-history=\"false\"", "") != fragment);
  stdio.println(fragment.replace_literal("<img", "") == fragment);
  stdio.println(fragment.replace_literal("&lt;img src=x onerror=alert(1)&gt;", "") != fragment);
  stdio.println(fragment.replace_literal("value=\"x&quot; onfocus=&quot;steal&amp;\"", "") != fragment);
  stdio.println(fragment.replace_literal("hx-post=\"/counter/increment\"", "") != fragment);

  val page = markup.render(counter_view.page("42", "csrf-secret"));
  stdio.println(page.replace_literal("<main hx-history=\"false\">", "") != page);
  stdio.println(page.replace_literal("<form", "") != page);
  stdio.println(page.replace_literal("hx-history=\"false\"", "") != page);
  stdio.println(page.replace_literal("value=\"csrf-secret\"", "") != page);
  return;
}
